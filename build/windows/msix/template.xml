<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="edge-desktop-base-amd64-installer.exe"
        Arguments=""
        InstallLocation="C:\Program Files\xu756\edge-desktop-base">
    </Installer>
    <PackageInformation
        PackageName="io.github.xu756.edge-desktop-base"
        PackageDisplayName="edge-desktop-base"
        PublisherName="CN=xu756"
        PublisherDisplayName="xu756"
        Version="0.1.0.0"
        PackageDescription="Reusable Wails v3 desktop application foundation">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="App"
                Description="Reusable Wails v3 desktop application foundation"
                DisplayName="edge-desktop-base"
                ExecutableName="edge-desktop-base.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>edge-desktop-base</DisplayName>
            <PublisherDisplayName>xu756</PublisherDisplayName>
            <Description>Reusable Wails v3 desktop application foundation</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="edge-desktop-base.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
